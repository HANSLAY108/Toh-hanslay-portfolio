# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Public Site URL (used for canonical URLs & hreflang metadata)
NEXT_PUBLIC_SITE_URL=https://hanslay.atelier.dev

# Default Cal.com Scheduling URL (can also be overridden in Admin -> Site Settings)
NEXT_PUBLIC_CAL_COM_URL=https://cal.com/toh-hanslay-end0cx/30min

# Optional Owner Email to restrict admin access
ADMIN_OWNER_EMAIL=hanslay@atelier.dev

# Next.js Revalidation Secret (optional for on-demand revalidation)
REVALIDATION_SECRET=your-secret-token-here
